rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. RBAC Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin') || (isAuthenticated() && request.auth.token.email == 'fathy93091@gmail.com');
    }

    function isSupervisor() {
      return hasRole('supervisor') || isAdmin();
    }

    function isTeacher() {
      return hasRole('teacher') || isSupervisor();
    }

    function isParent() {
      return hasRole('parent') || isSupervisor();
    }

    // 3. User Document & Workspace Policy
    match /users/{userId} {
      // READ: Users can read their own profile; Supervisors and Admins can view any user profile
      allow read: if isOwner(userId) || isSupervisor();

      // CREATE: Authenticated users can create their own profile; Admins can create user profiles
      allow create: if (isOwner(userId) && request.resource.data.uid == userId) || isAdmin();

      // UPDATE: Users can update their own non-role fields; Admins have full update rights
      allow update: if (isOwner(userId) && (request.resource.data.role == resource.data.role || isAdmin())) || isAdmin();

      // DELETE: Only Admins can delete user profiles
      allow delete: if isAdmin();

      // Subcollections inside user document (e.g. settings, legacy records)
      match /{document=**} {
        allow read, write: if isOwner(userId) || isSupervisor();
      }
    }

    // 4. Teachers Collection
    match /teachers/{teacherId} {
      allow read: if isSupervisor() || (isAuthenticated() && (resource.data.authUid == request.auth.uid || request.auth.uid == teacherId));
      allow create, update: if isSupervisor() || (isAuthenticated() && request.auth.uid == request.resource.data.authUid);
      allow delete: if isAdmin();
    }

    // 5. Parents Collection
    match /parents/{parentId} {
      allow read: if isSupervisor() || (isAuthenticated() && (resource.data.authUid == request.auth.uid || request.auth.uid == parentId));
      allow create, update: if isSupervisor() || (isAuthenticated() && request.auth.uid == request.resource.data.authUid);
      allow delete: if isAdmin();
    }

    // 6. Sensitive Contacts (Parent WhatsApp, Group Links) - STRICTLY ISOLATED FROM TEACHERS
    match /sensitive_contacts/{entityId} {
      allow read, write: if isSupervisor();
    }

    // 7. Centralized Students Collection
    match /students/{studentId} {
      allow read: if isSupervisor() || (
        isAuthenticated() && (
          (resource.data.teacherIds != null && request.auth.uid in resource.data.teacherIds) ||
          (resource.data.parentIds != null && request.auth.uid in resource.data.parentIds) ||
          resource.data.teacherId == request.auth.uid
        )
      );
      allow create: if isSupervisor() || (
        isAuthenticated() && (
          (request.resource.data.teacherIds != null && request.auth.uid in request.resource.data.teacherIds) ||
          request.resource.data.teacherId == request.auth.uid
        )
      );
      allow update: if isSupervisor() || (
        isAuthenticated() && (
          (resource.data.teacherIds != null && request.auth.uid in resource.data.teacherIds) ||
          resource.data.teacherId == request.auth.uid
        )
      );
      allow delete: if isSupervisor();
    }

    // 8. Centralized Study Groups Collection
    match /groups/{groupId} {
      allow read: if isSupervisor() || (
        isAuthenticated() && (
          (resource.data.teacherIds != null && request.auth.uid in resource.data.teacherIds) ||
          (resource.data.studentIds != null && request.auth.uid in resource.data.studentIds)
        )
      );
      allow create: if isSupervisor() || (
        isAuthenticated() && (
          (request.resource.data.teacherIds != null && request.auth.uid in request.resource.data.teacherIds)
        )
      );
      allow update: if isSupervisor() || (
        isAuthenticated() && (
          (resource.data.teacherIds != null && request.auth.uid in resource.data.teacherIds)
        )
      );
      allow delete: if isSupervisor();
    }

    // 9. Centralized Lessons Collection
    match /lessons/{lessonId} {
      allow read: if isSupervisor() || (
        isAuthenticated() && (
          resource.data.teacherId == request.auth.uid ||
          resource.data.studentId == request.auth.uid
        )
      );
      allow create: if isSupervisor() || (
        isAuthenticated() && request.resource.data.teacherId == request.auth.uid
      );
      allow update: if isSupervisor() || (
        isAuthenticated() && resource.data.teacherId == request.auth.uid
      );
      allow delete: if isSupervisor() || (
        isAuthenticated() && resource.data.teacherId == request.auth.uid
      );
    }

    // 10. Centralized Attendance Records
    match /attendance/{attendanceId} {
      allow read: if isSupervisor() || (
        isAuthenticated() && (
          resource.data.teacherId == request.auth.uid ||
          resource.data.studentId == request.auth.uid
        )
      );
      allow create: if isSupervisor() || (
        isAuthenticated() && request.resource.data.teacherId == request.auth.uid
      );
      allow update, delete: if isSupervisor() || (
        isAuthenticated() && resource.data.teacherId == request.auth.uid
      );
    }

    // 11. Centralized Reports Collection
    match /reports/{reportId} {
      allow read: if isSupervisor() || (
        isAuthenticated() && (
          resource.data.teacherId == request.auth.uid ||
          resource.data.studentId == request.auth.uid
        )
      );
      allow create: if isSupervisor() || (
        isAuthenticated() && request.resource.data.teacherId == request.auth.uid
      );
      allow update, delete: if isSupervisor() || (
        isAuthenticated() && resource.data.teacherId == request.auth.uid
      );
    }

    // 12. Centralized Payments Collection
    match /payments/{paymentId} {
      allow read: if isSupervisor() || (
        isAuthenticated() && (
          resource.data.teacherId == request.auth.uid ||
          resource.data.studentId == request.auth.uid
        )
      );
      allow create: if isSupervisor() || (
        isAuthenticated() && request.resource.data.teacherId == request.auth.uid
      );
      allow update, delete: if isSupervisor() || (
        isAuthenticated() && resource.data.teacherId == request.auth.uid
      );
    }

    // 13. Student Certificates & Honors Collection
    match /certificates/{certId} {
      allow read: if isSupervisor() || (
        isAuthenticated() && (
          resource.data.studentId == request.auth.uid ||
          resource.data.teacherId == request.auth.uid
        )
      );
      allow write: if isSupervisor() || (
        isAuthenticated() && request.resource.data.teacherId == request.auth.uid
      );
    }

    // 14. Site Content CMS Collection (Public Read, Admin/Supervisor Write)
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isSupervisor();
    }

    // 15. WhatsApp Outbox & Settings (Strictly Admin & Supervisor only)
    match /whatsapp_outbox/{messageId} {
      allow read, write: if isSupervisor();
    }

    match /whatsapp_settings/{settingId} {
      allow read, write: if isSupervisor();
    }
  }
}


