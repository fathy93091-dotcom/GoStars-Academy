{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with RBAC role, account status, and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "supervisor", "teacher", "parent"] },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["active", "suspended", "pending"] },
        "photoURL": { "type": "string", "maxLength": 500 },
        "phoneNumber": { "type": "string", "maxLength": 50 },
        "assignedTeacherId": { "type": "string", "maxLength": 128 },
        "assignedStudentIds": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "role", "name", "email", "status"]
    },
    "Student": {
      "title": "Student",
      "description": "Student profile managed by Islamic teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 150 },
        "preferredName": { "type": "string", "maxLength": 100 },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "dateOfBirth": { "type": "string", "maxLength": 50 },
        "age": { "type": "number" },
        "nationality": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "timeZone": { "type": "string", "maxLength": 100 },
        "parentName": { "type": "string", "maxLength": 150 },
        "parentContact": { "type": "string", "maxLength": 100 },
        "currentLevel": { "type": "string", "maxLength": 100 },
        "subjects": { "type": "array" },
        "status": { "type": "string", "enum": ["Active", "Archived"] },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "lastActiveDate": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "fullName", "parentName", "gender", "status"]
    },
    "Session": {
      "title": "Session",
      "description": "Teaching session record for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sessionNumber": { "type": "number" },
        "studentId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "maxLength": 50 },
        "durationMinutes": { "type": "number" },
        "subjectRecords": { "type": "array" },
        "status": { "type": "string", "enum": ["completed", "in_progress", "cancelled"] },
        "reportStatus": { "type": "string", "enum": ["none", "draft", "pending_approval", "approved"] },
        "reportId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "sessionNumber", "date", "status"]
    },
    "DailyReport": {
      "title": "DailyReport",
      "description": "Daily teaching evaluation report generated for parents",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 150 },
        "reportType": { "type": "string", "enum": ["daily"] },
        "title": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 50 },
        "sessionNumber": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "subjectsCovered": { "type": "array" },
        "overallPerformanceSummary": { "type": "string", "maxLength": 4000 },
        "homeworkSummary": { "type": "array" },
        "teacherRemarks": { "type": "string", "maxLength": 4000 },
        "closingMessage": { "type": "string", "maxLength": 1000 },
        "contentEnglish": { "type": "string", "maxLength": 10000 },
        "contentArabic": { "type": "string", "maxLength": 10000 },
        "isApproved": { "type": "boolean" },
        "isDraft": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "lastModified": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "sessionId", "isApproved"]
    },
    "MonthlyReport": {
      "title": "MonthlyReport",
      "description": "Monthly comprehensive academic progress report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "month": { "type": "string", "maxLength": 50 },
        "year": { "type": "number" },
        "reportType": { "type": "string", "enum": ["monthly"] },
        "title": { "type": "string", "maxLength": 200 },
        "overallProgress": { "type": "string", "maxLength": 4000 },
        "totalSessionsCompleted": { "type": "number" },
        "attendanceDays": { "type": "number" },
        "homeworkCompletionRate": { "type": "number" },
        "learningDevelopment": { "type": "string", "maxLength": 4000 },
        "strengths": { "type": "array" },
        "areasForImprovement": { "type": "array" },
        "teacherRecommendations": { "type": "string", "maxLength": 4000 },
        "closingMessage": { "type": "string", "maxLength": 1000 },
        "contentEnglish": { "type": "string", "maxLength": 10000 },
        "contentArabic": { "type": "string", "maxLength": 10000 },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "month", "year", "isApproved"]
    },
    "StudentMemory": {
      "title": "StudentMemory",
      "description": "Long-term educational memory tracking for student progress",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "educationalHistory": { "type": "array" },
        "homeworkHistory": { "type": "array" },
        "strengths": { "type": "array" },
        "areasForImprovement": { "type": "array" },
        "recurringMistakes": { "type": "array" },
        "teacherNotes": { "type": "array" },
        "progressSummary": { "type": "string", "maxLength": 4000 },
        "lastUpdated": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Teacher app preferences and permanent AI rules",
      "type": "object",
      "properties": {
        "preferredLanguage": { "type": "string", "enum": ["en", "ar"] },
        "reportStyle": { "type": "string", "enum": ["detailed", "bulleted", "concise"] },
        "defaultClosingMessage": { "type": "string", "maxLength": 1000 },
        "writingTone": { "type": "string", "enum": ["encouraging", "formal", "academic"] },
        "aiRules": { "type": "array" },
        "notificationPreferences": { "type": "object" }
      },
      "required": ["preferredLanguage", "reportStyle"]
    },
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Full cloud backup and synchronization workspace for the authenticated teacher",
      "type": "object",
      "properties": {
        "version": { "type": "string", "maxLength": 20 },
        "exportedAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "settings": { "type": "object" },
        "students": { "type": "array" },
        "groups": { "type": "array" },
        "privateLessons": { "type": "array" },
        "lessons": { "type": "array" },
        "attendanceRecords": { "type": "array" },
        "examRecords": { "type": "array" },
        "paymentTransactions": { "type": "array" },
        "reports": { "type": "array" }
      },
      "required": ["version"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile and legacy/fallback workspace document"
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/TeacherRecord" },
      "description": "Academy teachers collection"
    },
    "/parents/{parentId}": {
      "schema": { "$ref": "#/entities/ParentRecord" },
      "description": "Academy parents collection"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Centralized student records"
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Study groups collection"
    },
    "/sensitive_contacts/{entityId}": {
      "schema": { "$ref": "#/entities/SensitiveContactRecord" },
      "description": "Isolated sensitive contacts protected from direct teacher access"
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "Individual lessons collection"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Attendance tracking records"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/GeneratedReport" },
      "description": "Student lesson and periodic reports"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Financial payment records"
    }
  }
}
